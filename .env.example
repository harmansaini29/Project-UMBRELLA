# ==============================================================================
# PROJECT UMBRELLA: ENVIRONMENT CONFIGURATION
# 100% Local, Offline, Private Execution (Zero external cloud API keys required)
# ==============================================================================

# Dashboard & Platform Server
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000

# Target Microservice (Karamstay Demo Booking & Payments)
DEMO_APP_HOST=0.0.0.0
DEMO_APP_PORT=8002
DEMO_DATABASE_URL=sqlite:///./demo_booking_db.sqlite

# Target Microservice Connection Pool Initial Limits
DEMO_POOL_SIZE=2
DEMO_MAX_OVERFLOW=0
DEMO_POOL_TIMEOUT=1.0

# Central Hybrid RAG Storage Paths
RAG_STORAGE_DIR=rag/storage
RAG_BM25_PATH=rag/storage/bm25.pkl
RAG_FAISS_DIR=rag/storage/faiss

# Reinforcement Learning & Evolution Engine
EVOLUTION_MEMORY_PATH=data/evolution_memory.json
EVO_DEFAULT_TIMEFRAME=24h

# System DNA Storage Capsule
CAPSULE_OUTPUT_DIR=capsules
